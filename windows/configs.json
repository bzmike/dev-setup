{
  "config_groups": [
    {
      "name": "GlazeWM",
      "enabled": true,
      "files": [
        {
          "source": "glazewm/config.yaml",
          "target": "~\\.glzr\\glazewm\\config.yaml",
          "overwrite": true,
          "backup": true
        }
      ]
    },
    {
      "name": "Zebar",
      "enabled": true,
      "files": [
        {
          "source": "zebar/settings.json",
          "target": "~\\.glzr\\zebar\\settings.json",
          "overwrite": true,
          "backup": true
        }
      ]
    },
    {
      "name": "Git",
      "enabled": true,
      "files": [
        {
          "source": "git/.gitconfig",
          "source_base": "shared",
          "target": "~\\.gitconfig",
          "overwrite": true,
          "backup": true
        },
        {
          "source": "generated/.gitconfig-private",
          "source_base": "local",
          "target": "~\\.gitconfig-private",
          "overwrite": true,
          "backup": true
        },
        {
          "source": "generated/.gitconfig-work",
          "source_base": "local",
          "target": "~\\.gitconfig-work",
          "overwrite": true,
          "backup": true
        }
      ]
    },
    {
      "name": "SSH",
      "enabled": true,
      "files": [
        {
          "source": "generated/ssh-config",
          "source_base": "local",
          "target": "~\\.ssh\\config",
          "overwrite": true,
          "backup": true
        }
      ]
    },
    {
      "name": "WezTerm",
      "enabled": true,
      "files": [
        {
          "source": "wezterm/.wezterm.lua",
          "source_base": "local",
          "target": "~\\.wezterm.lua",
          "overwrite": true,
          "backup": true
        }
      ]
    }
  ]
}